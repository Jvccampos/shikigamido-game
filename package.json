{
  "name": "shikigamido-game",
  "private": true,
  "scripts": {
    "build": "npm run typecheck && node scripts/assets.mjs && vite build",
    "dev": "node scripts/dev.mjs",
    "deploy": "wrangler deploy",
    "typecheck": "npm run types && tsc --noEmit && tsc --noEmit -p tsconfig.worker.json",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:browser": "playwright test",
    "start": "wrangler dev",
    "test:multiplayer": "playwright test --grep multiplayer",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "types": "wrangler types"
  },
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.5.1",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "wrangler": "4.135.0"
  },
  "dependencies": {
    "pixi.js": "^8.20.1",
    "preact": "^10.29.8"
  }
}
