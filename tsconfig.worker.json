{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["./worker-configuration.d.ts"],
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": ["server/worker.ts", "server/sqlite-durable.ts"]
}
